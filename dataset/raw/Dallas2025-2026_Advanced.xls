<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet><x:Name>Worksheet</x:Name><x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions></x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]--></head><body><table>   <thead> <tr> <th aria-label="Rk" data-stat="ranker" scope="col" class="ranker poptip center" data-tip="Rank">Rk</th> <th aria-label="Player" data-stat="name_display" scope="col" class=" poptip sort_default_asc center">Player</th> <th aria-label="Age" data-stat="age" scope="col" class=" poptip center" data-tip="Player's age on January 31 of the season">Age</th> <th aria-label="Pos" data-stat="pos" scope="col" class=" poptip center" data-tip="Position">Pos</th> <th aria-label="G" data-stat="games" scope="col" class=" poptip center" data-tip="Games">G</th> <th aria-label="GS" data-stat="games_started" scope="col" class=" poptip center" data-tip="Games Started">GS</th> <th aria-label="MP" data-stat="mp" scope="col" class=" poptip center" data-tip="Minutes Played">MP</th> <th aria-label="PER" data-stat="per" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;b&gt;Player Efficiency Rating&lt;/b&gt;&lt;br&gt;A measure of per-minute production standardized such that the league average is 15." data-filter="1" data-name="">PER</th> <th aria-label="TS%" data-stat="ts_pct" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;True Shooting Percentage&lt;/strong&gt;&lt;br&gt;A measure of shooting efficiency that takes into account 2-point field goals, 3-point field goals, and free throws." data-filter="1" data-name="">TS%</th> <th aria-label="3PAr" data-stat="fg3a_per_fga_pct" scope="col" class=" poptip hide_non_quals center" data-tip="&lt;strong&gt;3-Point Attempt Rate&lt;/strong&gt;&lt;br&gt;Percentage of FG Attempts from 3-Point Range" 